---
import Card from "blume/components/content/Card.astro";
import CardGroup from "blume/components/content/CardGroup.astro";
import { contentHref } from "blume/components/content/base-href.ts";
---

<section>
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="font-medium text-3xl tracking-tight sm:text-4xl">
      Batteries included.
    </h2>
    <p class="mx-auto mt-4 max-w-lg text-balance text-muted-foreground">
      Recipes, MCP, CI, and agent scaffolding — same index, adopt what you need.
    </p>
  </div>

  <div class="mt-10">
    <CardGroup cols={2}>
      <Card
        arrow
        href={contentHref("/recipes")}
        icon="book-open"
        title="Answer agent questions with named SQL"
      >
        Bundled recipes for symbol lookup, impact, dead code, and CI formats.
      </Card>
      <Card
        arrow
        href={contentHref("/guides/agents-mcp")}
        icon="plug"
        title="Query from Cursor over MCP"
      >
        Same recipes as the CLI — tools and resources on the live index.
      </Card>
      <Card
        arrow
        href={contentHref("/guides/github-action")}
        icon="github"
        title="Gate PRs with recipe SARIF"
      >
        Run recipes in CI with SARIF, annotations, and badge exit codes.
      </Card>
      <Card
        arrow
        href={contentHref("/guides/agents-mcp")}
        icon="bot"
        title="Scaffold agent rules that stay current"
      >
        `agents init` writes version-matched pointers; package updates refresh
        served skill/rule content.
      </Card>
    </CardGroup>
  </div>
</section>
