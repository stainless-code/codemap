# Codemap docs — Apache config for the /codemap subpath.
# Deployed to the /codemap folder by the Deploy docs workflow (the FTP account
# is scoped to /codemap, so this lands at /codemap/.htaccess). Do NOT list
# .htaccess in the workflow exclude — it rides along in dist/.

# Don't list directories; serve index.html for clean URLs (/codemap/guides/getting-started
# resolves to guides/getting-started/index.html).
Options -Indexes
DirectoryIndex index.html

# Block direct access to dotfiles (e.g. the FTP-deploy sync-state file).
# .well-known/ stays reachable: requests target files inside it whose names
# do not start with a dot (ACME challenge, etc.).
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Site ships a 404.html; serve it for misses instead of Apache's default.
ErrorDocument 404 /codemap/404.html

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  # Self assets + hashed _astro bundles, local search, inline theme/banner scripts
  # (data-attr driven, no nonce). No analytics/external CDNs — relax script-src if needed.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# llms.txt + raw .md/.mdx mirrors: static hosting doesn't apply Astro endpoint
# Response headers, so declare UTF-8 + the right type here, and keep the mirrors
# out of the index (canonical HTML pages are what should be crawled). robots.txt
# is intentionally excluded.
<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType text/markdown .md .mdx
  AddCharset UTF-8 .txt .md .mdx
</IfModule>
<FilesMatch "\.mdx?$">
  Header set X-Robots-Tag "noindex"
</FilesMatch>
<FilesMatch "^llms(-full|-small)?\.txt$">
  Header set X-Robots-Tag "noindex"
</FilesMatch>

# Agent discovery (isitagentready) — Apache port of dist/_headers.
# Apache ignores that file; this is what actually ships headers under /codemap.
<IfModule mod_mime.c>
  AddType application/json .json
  AddType application/gzip .tar.gz
</IfModule>

# Homepage Link header (RFC 8288 / RFC 9727 s3). Minimal form; keep in sync with dist/_headers.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/codemap/$" IS_CODEMAP_HOME
  SetEnvIf Request_URI "^/codemap/index\.html$" IS_CODEMAP_HOME
</IfModule>
<IfModule mod_headers.c>
  Header always set Link "</codemap/.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\", </codemap/.well-known/ai-catalog.json>; rel=\"ai-catalog\"; type=\"application/ai-catalog+json\", </codemap/openapi.json>; rel=\"service-desc\"; type=\"application/json\", </codemap/agent-readability.json>; rel=\"describedby\"; type=\"application/json\", </codemap/llms.txt>; rel=\"describedby\"; type=\"text/plain\", </codemap/index.md>; rel=\"alternate\"; type=\"text/markdown\"" env=IS_CODEMAP_HOME
</IfModule>

# Extensionless file needs explicit type (else text/plain fails the scan).
<Files "api-catalog">
  ForceType 'application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"'
</Files>

<IfModule mod_headers.c>
  <FilesMatch "(^ai-catalog\.json$|^ard\.json$|^api-catalog$|index\.json$)">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# Pragmatic Accept: text/markdown (static-first, not strict RFC).
# Subdir rules shadow the domain-root rewrite block, so both live here.
<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{REQUEST_URI} \.(css|js|mjs|map|png|jpe?g|webp|gif|svg|avif|ico|woff2?|ttf|otf|eot|xml|txt|json|pdf|mp4|webm|mp3|wav|ogg|zip)$ [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} \.mdx?$ [NC]
RewriteRule ^ - [L]

# /codemap/ -> /codemap/index.md
RewriteCond %{HTTP:Accept} text/markdown [NC]
RewriteCond %{HTTP:Accept} !text/markdown\s*;\s*q\s*=\s*0(\.0*)?(\s*[;,]|\s*$) [NC]
RewriteRule ^$ /codemap/index.md [L,T=text/markdown]

# /codemap/<route> -> twin .md
RewriteCond %{HTTP:Accept} text/markdown [NC]
RewriteCond %{HTTP:Accept} !text/markdown\s*;\s*q\s*=\s*0(\.0*)?(\s*[;,]|\s*$) [NC]
RewriteCond %{REQUEST_FILENAME} !\.md$ [NC]
RewriteCond %{DOCUMENT_ROOT}/codemap/$1.md -f
RewriteRule ^(.+?)/?$ /codemap/$1.md [L,T=text/markdown]
</IfModule>
