---
import CodeBlock from "blume/components/content/CodeBlock.astro";
import { contentHref } from "blume/components/content/base-href.ts";
import InstallBox from "./InstallBox.astro";
import { cliSnippet } from "./source-snippets.ts";
---

<section class="text-center">
  <h1
    class="mx-auto max-w-3xl text-balance font-medium text-4xl tracking-tight sm:text-5xl lg:text-6xl"
  >
    <span class="block">Stop scanning for one symbol.</span>
    <span class="block text-accent">Query your codebase.</span>
  </h1>

  <p class="mx-auto mt-6 max-w-2xl text-balance text-foreground text-lg">
    Local codebase intelligence: a SQLite index of symbols, imports, and calls —
    SQL and recipes for agents, not another grep pass.
  </p>

  {/* Blume CodeBlock fills the column — shrink-wrap like InstallBox. */}
  <div
    class="mx-auto mt-8 w-max max-w-full text-left [&_.prose]:contents [&_figure]:m-0 [&_figure]:w-max [&_figure]:max-w-full [&_pre]:!m-0 [&_pre]:w-max [&_pre]:max-w-full"
  >
    <CodeBlock code={cliSnippet.code} lang={cliSnippet.lang} />
  </div>

  <div class="mt-9"><InstallBox /></div>

  <div class="mt-7 flex items-center justify-center gap-6 text-sm">
    <a
      class="inline-flex items-center gap-1 rounded-blume bg-accent px-5 py-2.5 font-medium text-accent-foreground text-sm transition-opacity hover:opacity-90"
      href={contentHref("/guides/getting-started")}
    >
      Get started
      <svg
        class="size-3.5"
        fill="none"
        height="14"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="14"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </a>
    <a
      class="inline-flex items-center gap-1 font-medium text-muted-foreground transition-colors hover:text-foreground"
      href={contentHref("/recipes")}
    >
      Browse recipes
      <svg
        class="size-3.5"
        fill="none"
        height="14"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="14"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </a>
  </div>
</section>
